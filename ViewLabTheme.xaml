<?xml version="1.0" encoding="utf-8"?>
<!--
  ViewLab shared theme.

  Purpose: ViewLab had no Application.Resources, so every window re-declared its own theme from
  scratch and they drifted apart generation by generation. This dictionary holds the styles that
  were MISSING from one or more windows, so a control looks the same wherever it is used.

  Deliberately narrow. It carries ONLY:
    * CheckBox   — copied verbatim from MainWindow.xaml. WPF's default CheckBox style pins
                   Foreground to SystemColors.ControlTextBrushKey (black), which beats inheritance
                   from the Window, so any window without this style gets black labels on a dark
                   panel. That is the 4.1.305 DiagMon bug; ProfileWindow had 20 more of them and
                   PerformanceTraceWindow one.
    * ComboBox   — MainWindow and ProfileWindow defined none between them (36 combo boxes), so they
                   rendered in WPF's default light chrome on dark panels while DiagMon's were dark.
                   Colours below are MainWindow's own input/button palette, not a new scheme.
    * HelpBadge  — the circular "?" affordance, previously hand-rolled three times at three
                   different sizes and border weights.

  It does NOT restyle Expander, Slider, Button, TextBox or DataGrid. Those already look the way the
  user wants in MainWindow, and a window that defines its own copy keeps it: locally-declared
  resources take precedence over merged ones, so merging this dictionary into MainWindow changes
  nothing there except the combo boxes it never styled.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- MainWindow's existing values, restated here so the styles below do not depend on the
       consuming window having declared them. -->
  <SolidColorBrush x:Key="ThemeInputBrush" Color="#080909" />
  <SolidColorBrush x:Key="ThemeInputBorderBrush" Color="#3A3D42" />
  <SolidColorBrush x:Key="ThemeTextBrush" Color="#E8E8E8" />
  <SolidColorBrush x:Key="ThemeHoverBrush" Color="#253A55" />
  <SolidColorBrush x:Key="ThemeAccentBrush" Color="#C90012" />

  <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
    <Setter Property="Foreground" Value="#D8D8D8" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}">
    <Setter Property="Background" Value="{StaticResource ThemeInputBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ThemeTextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ThemeInputBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MaxDropDownHeight" Value="320" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid>
            <ToggleButton Name="DropDownToggle" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                  <Border Name="Face" Background="{StaticResource ThemeInputBrush}"
                          BorderBrush="{StaticResource ThemeInputBorderBrush}" BorderThickness="1" CornerRadius="3">
                    <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                          Fill="#D8D8D8" Data="M 0 0 L 8 0 L 4 4 Z" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Face" Property="Background" Value="#15171A" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter TargetName="Face" Property="Background" Value="#111214" />
                      <Setter TargetName="Face" Property="Opacity" Value="0.75" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Name="Selection" IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                              Margin="8,3,28,3" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
            <Popup Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
              <Border Name="DropDownBorder"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      Background="{StaticResource ThemeInputBrush}"
                      BorderBrush="{StaticResource ThemeInputBorderBrush}" BorderThickness="1">
                <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                  <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Selection" Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Type ComboBoxItem}" TargetType="{x:Type ComboBoxItem}">
    <Setter Property="Background" Value="{StaticResource ThemeInputBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ThemeTextBrush}" />
    <Setter Property="Padding" Value="8,5" />
    <Style.Triggers>
      <Trigger Property="IsHighlighted" Value="True">
        <Setter Property="Background" Value="{StaticResource ThemeHoverBrush}" />
        <Setter Property="Foreground" Value="White" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource ThemeAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- One definition for the circular "?" affordance. Apply to a Border and put a TextBlock with
       Text="?" inside, or use HelpBadgeGlyph for the label. Sizes match the MainWindow original. -->
  <Style x:Key="HelpBadge" TargetType="{x:Type Border}">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="White" />
    <Setter Property="BorderThickness" Value="1.2" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style x:Key="HelpBadgeGlyph" TargetType="{x:Type TextBlock}">
    <Setter Property="Text" Value="?" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</ResourceDictionary>
