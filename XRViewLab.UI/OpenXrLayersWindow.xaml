<Window x:Class="XRViewLab.UI.OpenXrLayersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenXR API Layers" Height="640" Width="900" MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="#E8E8E8"
        FontFamily="Segoe UI" FontSize="12">

  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#15171A" />
    <SolidColorBrush x:Key="BorderBrush2" Color="#3A3D42" />
    <SolidColorBrush x:Key="InputBrush" Color="#080909" />
    <SolidColorBrush x:Key="AccentBrush" Color="#C90012" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9A9A9A" />

    <Style x:Key="HelpBadge" TargetType="Border">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="White" />
      <Setter Property="BorderThickness" Value="1.2" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style x:Key="HelpBadgeGlyph" TargetType="TextBlock">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="RedButton" TargetType="Button">
      <Setter Property="Foreground" Value="#F0F0F0" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="#1D2024" BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#2A2E34" />
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScopeTab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#B8B8B8" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" Background="#15171A" BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1" CornerRadius="3" Padding="12,6">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1F2226" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#2A1114" />
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="#0E0F11" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6">
  <DockPanel LastChildFill="True">
    <!-- ViewLab-drawn titlebar: the default Windows chrome did not match the rest of the app. -->
    <Grid DockPanel.Dock="Top" Height="42" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <TextBlock Text="OPENXR  API  LAYERS" FontSize="13" FontWeight="Bold" Foreground="#E8E8E8" VerticalAlignment="Center" Margin="16,0,0,0" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Border Style="{StaticResource HelpBadge}" Margin="0,0,10,0" ToolTip="About OpenXR API Layers" MouseLeftButtonUp="OpenXrLayersHelp_Click">
          <TextBlock Text="?" Style="{StaticResource HelpBadgeGlyph}" />
        </Border>
        <TextBlock Name="TitleClose" Text="X" FontSize="14" Foreground="{StaticResource MutedBrush}" Cursor="Hand" Padding="14,8,16,8" MouseLeftButtonDown="TitleClose_MouseLeftButtonDown" MouseEnter="TitleClose_MouseEnter" MouseLeave="TitleClose_MouseLeave" />
      </StackPanel>
    </Grid>
  <Grid Margin="12,0,12,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
      <RadioButton x:Name="ScopeW64M" Style="{StaticResource ScopeTab}" GroupName="scope" IsChecked="True"
                   Tag="0" Checked="Scope_Changed" Content="Win64 · All users" />
      <RadioButton x:Name="ScopeW64U" Style="{StaticResource ScopeTab}" GroupName="scope"
                   Tag="1" Checked="Scope_Changed" Content="Win64 · This user" />
      <RadioButton x:Name="ScopeW32M" Style="{StaticResource ScopeTab}" GroupName="scope"
                   Tag="2" Checked="Scope_Changed" Content="Win32 · All users" />
      <RadioButton x:Name="ScopeW32U" Style="{StaticResource ScopeTab}" GroupName="scope"
                   Tag="3" Checked="Scope_Changed" Content="Win32 · This user" />
    </StackPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="150" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
              BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="4" Padding="4">
        <ListBox x:Name="LayerList" Background="Transparent" BorderThickness="0" Foreground="#E8E8E8"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,0,3" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="#101215" BorderBrush="Transparent"
                            BorderThickness="1" CornerRadius="3" Padding="9,7">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="#171A1E" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="bd" Property="Background" Value="#1E1114" />
                        <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="30" Height="19" CornerRadius="3" VerticalAlignment="Top"
                        Margin="0,1,10,0" Background="{Binding StateBg}">
                  <TextBlock Text="{Binding StateText}" FontSize="9" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{Binding StateFg}" />
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#E8E8E8" />
                  <TextBlock Text="{Binding ManifestPath}" Foreground="#7E7E7E" FontSize="10"
                             TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                  <TextBlock Text="{Binding WarningText}" Foreground="#E0A85C" FontSize="10"
                             TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding WarningVisibility}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <StackPanel Grid.Column="2">
        <Button x:Name="EnableBtn" Style="{StaticResource RedButton}" Content="Enable" Click="Enable_Click" />
        <Button x:Name="DisableBtn" Style="{StaticResource RedButton}" Content="Disable" Click="Disable_Click" />
        <Button x:Name="UpBtn" Style="{StaticResource RedButton}" Content="Move up" Click="Up_Click" />
        <Button x:Name="DownBtn" Style="{StaticResource RedButton}" Content="Move down" Margin="0,0,0,14" Click="Down_Click" />
        <Button x:Name="AddBtn" Style="{StaticResource RedButton}" Content="Add layer..." Click="Add_Click" />
        <Button x:Name="RemoveBtn" Style="{StaticResource RedButton}" Content="Remove" Margin="0,0,0,14" Click="Remove_Click" />
        <Button Style="{StaticResource RedButton}" Content="Reload" Click="Reload_Click" />
        <Button Style="{StaticResource RedButton}" Content="Save report..." Click="Report_Click" />
        <Button Style="{StaticResource RedButton}" Content="Backup registry" Click="Backup_Click" />
      </StackPanel>
    </Grid>

    <TextBlock Grid.Row="3" x:Name="StatusText" Foreground="{StaticResource MutedBrush}"
               Margin="0,10,0,0" TextWrapping="Wrap" />
  </Grid>
  </DockPanel>
  </Border>
</Window>
